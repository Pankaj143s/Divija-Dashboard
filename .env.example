# ==============================================================================
# DIVIJA ADMIN DASHBOARD - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local and fill in your values

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOGO_PUBLIC_URL=https://docs.divijahome.org/public/divija-logo.png

# Supabase (shared database — same project as main site)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin credentials (username + password login)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# Session signing secret — separate from credentials, used only for HMAC cookie signing
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret
